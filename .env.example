# ---- Agora (audio transport) ----
# From Agora Console -> your project. Certificate is under "Security" (enable App Certificate).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---- Sarvam (speech-to-text) ----
SARVAM_API_KEY=

# ---- Deepgram (text-to-speech, Flux voices) ----
DEEPGRAM_API_KEY=

# ---- Phase 1 tunables ----
# How long a pause (seconds) counts as "the candidate stopped talking"
VAD_STOP_SECS=0.6
# Audio sample rate the worker uses internally (Hz)
AUDIO_SAMPLE_RATE=16000
# Port the media worker's HTTP API listens on (inside container + mapped to host)
MEDIA_WORKER_PORT=8080
