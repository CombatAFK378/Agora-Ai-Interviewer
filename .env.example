# ---- Agora (audio transport) ----
# From Agora Console -> your project. Certificate is under "Security" (enable App Certificate).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---- Sarvam (speech-to-text) ----
SARVAM_API_KEY=

# ---- Deepgram (text-to-speech, Aura voices) ----
DEEPGRAM_API_KEY=

# ---- LLM providers (both OpenAI-compatible) ----
# Required from Phase 2 on. Model ids carry a provider prefix: "groq:" or
# "openrouter:" (unprefixed = OpenRouter). The router walks the fallback chain
# across providers, so the fast path can be Groq with an OpenRouter fallback.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Fast model (candidate is waiting). gpt-oss-120b on Groq is sub-second.
LLM_FAST_MODEL=groq:openai/gpt-oss-120b
# Deep model for scoring/debate (used from Phase 5).
LLM_REASONING_MODEL=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# Comma-separated fallback ids, tried in order after the primary. Free model ids
# rotate without notice — keep a couple here so a delisting can't stall a turn.
LLM_FALLBACK_CHAIN=openrouter:inclusionai/ling-3.0-flash-fin:free

# ---- Smart Turn v3.1 (end-of-turn detection) ----
# Path to the ONNX weights (relative paths resolve from the repo root).
# Get them: python models/download_smart_turn.py
SMART_TURN_MODEL_PATH=models/smart-turn-v3.1.onnx
# p(complete) at/above this counts the turn as finished.
SMART_TURN_THRESHOLD=0.5

# ---- Turn-taking ----
# Whether the *normal mic* can interrupt the interviewer by talking over it.
# false = it can't (robust in any environment); true = it can (needs a quiet mic
# on headphones, else background noise false-triggers). The on-screen Interrupt
# button always works regardless — that's the reliable way to cut in.
ALLOW_BARGEIN=false

# ---- Tunables ----
# How long a pause (seconds) counts as end-of-speech. With Smart Turn deciding
# complete-vs-incomplete, keep this short (ARCHITECTURE §4 uses 0.2).
VAD_STOP_SECS=0.2
# Audio sample rate the worker uses internally (Hz)
AUDIO_SAMPLE_RATE=16000
# Port the media worker's HTTP API listens on (inside container + mapped to host)
MEDIA_WORKER_PORT=8080
